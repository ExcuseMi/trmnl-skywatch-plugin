{% assign view = 1 %}
{% if data.fetched_at %}{% assign local_timestamp = data.fetched_at | date: "%s" | plus: trmnl.user.utc_offset %}{% else %}{% assign local_timestamp = 'now' | date: "%s" | plus: trmnl.user.utc_offset %}{% endif %}{% assign cfv = trmnl.plugin_settings.custom_fields_values %}{% assign cd = "false" %}{% if cfv.closest_details == "true" %}{% assign cd = "true" %}{% endif %}{% if cfv.view == "xsection" and data.error_code == blank and data.planes != blank %}
{% assign instance_id = "inst_" | append_random %}
{% assign cfv = trmnl.plugin_settings.custom_fields_values %}

<div class="layout layout--stretch gap--none m--0 p--0" data-instance="{{ instance_id }}" data-chart="xsection" style="position:relative;">
  <span class="label label--inverted" style="position:absolute;top:8px;right:8px;z-index:10;">{{ data.provider | default: "airplanes.live" }}</span>
  <svg id="sky-xs-{{ instance_id }}" class="w--full h--full" style="position:absolute;top:0;left:0;z-index:2;" preserveAspectRatio="none">
    <defs id="sky-defs-{{ instance_id }}"></defs>
    <g id="sky-xs-grid-{{ instance_id }}"></g>
    <g id="sky-xs-leaders-{{ instance_id }}"></g>
    <g id="sky-xs-planes-{{ instance_id }}"></g>
  </svg>
  <div id="sky-xs-cards-{{ instance_id }}" style="position:absolute;top:0;left:0;width:100%;height:100%;overflow:hidden;z-index:6;"></div>
</div>

{% render "titlebar", trmnl: trmnl, local_timestamp: local_timestamp %}

<script>
(function () {
  var instanceId = '{{ instance_id }}';
  var planes     = {{ data.planes | json }};
  var baroRates  = {{ data.baro_rates | json | default: "[]" }};
  var destDists  = {{ data.dest_dists | json | default: "[]" }};
  planes.forEach(function (p, i) { p.baro_rate = baroRates[i] != null ? baroRates[i] : 0; if (destDists[i] != null) p.dest_dist_nm = destDists[i]; });
  var centerLat  = parseFloat('{{ data.lat | default: 51.5074 }}');
  var centerLon  = parseFloat('{{ data.lon | default: -0.1278 }}');
  var radiusNm   = parseFloat('{{ data.radius_nm | default: 50 }}') || 50;
  var fieldElev  = parseFloat('{{ data.field_elev_ft | default: 0 }}') || 0;
  var unit       = '{{ cfv.unit | default: "metric" }}';
  var axisMode   = '{{ cfv.xs_axis | default: "distance" | escape }}';
  var heading    = parseFloat('{{ cfv.xs_heading | default: 90 | escape }}');
  var showGround = '{{ cfv.show_ground }}' === 'true';
  var routeHidden = '{{ cfv.route_display }}' === 'hidden';
  var closestOn  = '{{ cfv.closest_details }}' === 'true';
  var localNow   = {{ local_timestamp | default: 0 }};
  var settingDark = '{{ trmnl.plugin_settings.dark_mode }}' === 'yes';

  if (axisMode !== 'eastwest' && axisMode !== 'heading') axisMode = 'distance';
  if (!isFinite(heading)) heading = 90;
  heading = ((Math.round(heading) % 360) + 360) % 360;

  function init() {
    var container = document.querySelector('.layout[data-instance="' + instanceId + '"]');
    if (!container) return;
    var svg = container.querySelector('#sky-xs-' + instanceId);
    var cardsLayer = container.querySelector('#sky-xs-cards-' + instanceId);
    var gridLayer = container.querySelector('#sky-xs-grid-' + instanceId);
    var leaderLayer = container.querySelector('#sky-xs-leaders-' + instanceId);
    var planeLayer = container.querySelector('#sky-xs-planes-' + instanceId);
    if (!svg || !cardsLayer) return;

    var ns = 'http://www.w3.org/2000/svg';
    var W = container.clientWidth || 768;
    var H = container.clientHeight || 400;
    svg.setAttribute('viewBox', '0 0 ' + W + ' ' + H);

    var screenEl = container.closest('.screen');
    var darkMode = screenEl ? screenEl.classList.contains('screen--dark-mode') : settingDark;
    var fg = darkMode ? '#ffffff' : '#000000';
    var gridColor = darkMode ? 'rgba(255,255,255,0.22)' : 'rgba(0,0,0,0.2)';
    var lineColor = darkMode ? 'rgba(255,255,255,0.55)' : 'rgba(0,0,0,0.45)';
    var titleEl = document.querySelector('.title_bar .title');
    var labelFont = titleEl ? getComputedStyle(titleEl).fontFamily : 'var(--title-bar-font-family), "NicoClean", monospace';
    var FT = 0.3048;

    {% render "icons" %}
{% if cd == "true" %}{% render "panel" %}{% endif %}
    // The end labels of the horizontal axis (pure): left and right, or null where all bearings are folded together.
    var COMPASS16 = ['N', 'NNE', 'NE', 'ENE', 'E', 'ESE', 'SE', 'SSE', 'S', 'SSW', 'SW', 'WSW', 'W', 'WNW', 'NW', 'NNW'];
    function axisEndLabels(axis, hdg) {
      if (axis === 'eastwest') return { left: 'W', right: 'E' };
      if (axis !== 'heading') return null;
      var deg3 = function (n) { return ('00' + n).slice(-3) + '\u00b0'; };
      var name = function (n) { return COMPASS16[Math.round(n / 22.5) % 16]; };
      var back = (hdg + 180) % 360;
      return { left: name(back) + ' ' + deg3(back), right: deg3(hdg) + ' ' + name(hdg) };
    }
    window.skyAxisEndLabels = axisEndLabels;

    function el(tag, attrs, parent) {
      var n = document.createElementNS(ns, tag);
      Object.keys(attrs).forEach(function (k) { n.setAttribute(k, attrs[k]); });
      if (parent) parent.appendChild(n);
      return n;
    }
    function f1(n) { return n.toFixed(1); }

    // ---- plot box -------------------------------------------------------
    var padL = 54, padR = 16, padB = 46, groundBand = 22, sc = 1.3, iconHalf = 12 * sc;
    // The provider label sits top right: the plot starts below it, so no icon can go under it.
    var labelEl = container.querySelector('.label');
    var cBox = container.getBoundingClientRect(), lBox = labelEl ? labelEl.getBoundingClientRect() : null;
    var labelRect = lBox ? { x: lBox.left - cBox.left, y: lBox.top - cBox.top, w: lBox.width, h: lBox.height } : { x: W - 120, y: 0, w: 120, h: 36 };
    var padT = Math.max(22, Math.ceil(labelRect.y + labelRect.h + iconHalf + 2));
    var px0 = padL, px1 = W - padR, py0 = padT, py1 = H - padB;
    var yZero = py1 - groundBand;            // 0 ft
    var plotH = yZero - py0;
    var signed = axisMode !== 'distance';
    var cx = (px0 + px1) / 2;

    // ---- geometry helpers -------------------------------------------------
    var RAD = Math.PI / 180;
    function offsets(p) {
      var dy = (p.lat - centerLat) * 60;
      var dx = (p.lon - centerLon) * 60 * Math.cos(centerLat * RAD);
      return { dx: dx, dy: dy };
    }
    function greatCircleNm(p) {
      var a = Math.pow(Math.sin((p.lat - centerLat) * RAD / 2), 2) +
        Math.cos(centerLat * RAD) * Math.cos(p.lat * RAD) * Math.pow(Math.sin((p.lon - centerLon) * RAD / 2), 2);
      return 2 * 3440.065 * Math.asin(Math.min(1, Math.sqrt(a)));
    }
    var COMPASS = ['N', 'NE', 'E', 'SE', 'S', 'SW', 'W', 'NW'];
    function compass(deg) { return COMPASS[Math.round((((deg % 360) + 360) % 360) / 45) % 8]; }
    function altFt(p) {
      if (p.alt_baro === 'ground') return fieldElev;
      return unit === 'imperial' ? +p.alt_baro : +p.alt_baro / FT;
    }

    // Along-axis position in nm (signed on signed axes), the cross-track offset and the travel direction.
    function place(p) {
      var o = offsets(p), d = greatCircleNm(p);
      var bearing = Math.atan2(o.dx, o.dy) / RAD;
      var tr = (p.track != null ? +p.track : 90) * RAD;
      var dir, along, cross = 0;
      if (axisMode === 'eastwest') {
        along = o.dx; dir = Math.sin(tr);
      } else if (axisMode === 'heading') {
        var h = heading * RAD;
        along = o.dx * Math.sin(h) + o.dy * Math.cos(h);
        cross = o.dx * Math.cos(h) - o.dy * Math.sin(h);
        dir = Math.cos(tr - h);
      } else {
        along = d; dir = Math.cos(tr - bearing * RAD);
      }
      if (p.track == null) dir = 1;
      return { along: along, cross: cross, dist: d, bearing: bearing, dir: dir >= 0 ? 1 : -1 };
    }

    // X: the inner zone (up to 15 nm or 30 km) takes half the width, the rest of the radius the other half. One
    // function (makeAxis) drives the aircraft, the ticks and anything else placed along the axis.
    function makeAxis(radius, km) {
      var brk = km ? 30 / 1.852 : 15;
      var tickList = km ? [0, 10, 20, 30, 40, 60, 80, radius * 1.852] : [0, 5, 10, 15, 20, 30, 40, radius];
      return {
        breakNm: brk,
        gx: function (distNm) {
          var a = Math.min(Math.abs(distNm), radius);
          return a <= brk ? 0.5 * a / brk : 0.5 + 0.5 * (a - brk) / (radius - brk);
        },
        ticksNm: tickList.map(function (t) { return km ? t / 1.852 : t; }).filter(function (t) { return t <= radius + 0.01; })
      };
    }
    window.skyMakeAxis = makeAxis;
    var kmMode = unit !== 'imperial';
    var axis = makeAxis(radiusNm, kmMode);
    var gx = axis.gx;
    function xOf(alongNm) {
      if (!signed) return px0 + gx(alongNm) * (px1 - px0);
      return cx + (alongNm < 0 ? -1 : 1) * gx(alongNm) * (px1 - px0) / 2;
    }

    // Y: 0 to 10,000 ft takes 45 % of the height, the rest goes up to the ceiling.
    var ceiling = 20000;
    function yOf(ft) {
      var lowH = 0.45 * plotH;
      var f = Math.max(0, ft);
      if (f <= 10000) return yZero - f / 10000 * lowH;
      return yZero - lowH - Math.min(1, (f - 10000) / (ceiling - 10000)) * (plotH - lowH);
    }

    // ---- which aircraft ---------------------------------------------------
    var SQUAWK_LABELS = { '7500': 'HIJACK', '7600': 'NORDO', '7700': 'MAYDAY' };
    var MAX_DRAWN = 12;
    var cand = (planes || []).filter(function (p) {
      if (p.lat == null || p.lon == null || p.alt_baro == null) return false;
      return p.alt_baro !== 'ground' || showGround;
    }).map(function (p) {
      var pl = place(p);
      return { p: p, pl: pl, ft: altFt(p), ground: p.alt_baro === 'ground', emerg: !!SQUAWK_LABELS[p.squawk] };
    });
    var chosen = cand.filter(function (c) { return c.emerg; }).slice(0, MAX_DRAWN);
    var rest = cand.filter(function (c) { return !c.emerg; });
    var low = rest.filter(function (c) { return c.ft < 10000; }).sort(function (a, b) { return a.pl.dist - b.pl.dist; });
    var high = rest.filter(function (c) { return c.ft >= 10000; }).sort(function (a, b) { return b.ft - a.ft; });
    low.concat(high).forEach(function (c) { if (chosen.length < MAX_DRAWN) chosen.push(c); });

    // With the closest-aircraft panel on, the closest aircraft is always one of those drawn.
    var closest = closestOn ? pickClosest(planes, centerLat, centerLon) : null;
    if (closest && !chosen.some(function (c) { return c.p === closest.p; })) {
      var extra = cand.filter(function (c) { return c.p === closest.p; })[0];
      if (extra) { if (chosen.length >= MAX_DRAWN) chosen.pop(); chosen.push(extra); }
    }

    var topFt = 0;
    chosen.forEach(function (c) { if (!c.ground && c.ft > topFt) topFt = c.ft; });
    ceiling = topFt <= 20000 ? 20000 : (topFt <= 30000 ? 30000 : (topFt <= 40000 ? 40000 : 50000));

    // ---- axes -----------------------------------------------------------
    function text(str, x, y, anchor, size, weight) {
      var t = el('text', { x: f1(x), y: f1(y), 'text-anchor': anchor, 'font-size': size || 12, fill: fg,
        'font-family': labelFont, 'font-weight': weight || 'normal' }, gridLayer);
      t.textContent = str;
      return t;
    }
    var yTicksFt = [];
    var yLabel = function (ft) { return String(unit === 'imperial' ? ft : Math.round(ft * FT)); };
    if (unit === 'imperial') {
      [0, 2500, 5000, 7500, 10000].forEach(function (v) { yTicksFt.push(v); });
      for (var t1 = 20000; t1 <= ceiling; t1 += 10000) yTicksFt.push(t1);
    } else {
      [0, 1000, 2000, 3000].forEach(function (m) { yTicksFt.push(m / FT); });
      [4000, 6000, 8000, 10000, 12000, 14000, 16000].forEach(function (m) { if (m / FT <= ceiling + 1) yTicksFt.push(m / FT); });
    }
    yTicksFt.forEach(function (ft) {
      var y = yOf(ft);
      el('line', { x1: px0, y1: f1(y), x2: px1, y2: f1(y), stroke: gridColor, 'stroke-width': 1, 'stroke-dasharray': ft === 0 ? '' : '2 4' }, gridLayer);
      text(yLabel(ft), px0 - 6, y + 4, 'end', 12);
    });
    text(unit === 'imperial' ? 'ft' : 'm', px0 - 6, py0 - 8, 'end', 12, 'bold');

    var xLabelY = py1 + 16;
    function xTickLabel(nm) { return String(kmMode ? Math.round(nm * 1.852) : Math.round(nm)); }
    function xAt(nm, side) { return signed ? cx + side * gx(nm) * (px1 - px0) / 2 : px0 + gx(nm) * (px1 - px0); }
    // the enlarged inner zone, shaded very faintly
    var zoneL = signed ? xAt(axis.breakNm, -1) : px0, zoneR = xAt(axis.breakNm, 1);
    el('rect', { x: f1(zoneL), y: py0, width: f1(zoneR - zoneL), height: f1(py1 - py0),
      fill: darkMode ? 'rgba(255,255,255,0.07)' : 'rgba(0,0,0,0.05)' }, gridLayer);
    var lastLabelX = {};
    axis.ticksNm.forEach(function (nm) {
      (signed && nm > 0 ? [-1, 1] : [1]).forEach(function (side) {
        var x = xAt(nm, side);
        el('line', { x1: f1(x), y1: py0, x2: f1(x), y2: f1(py1), stroke: gridColor, 'stroke-width': 1, 'stroke-dasharray': '2 4' }, gridLayer);
        // no label closer than 24 px to the previous one on its side
        if (lastLabelX[side] != null && Math.abs(x - lastLabelX[side]) < 24) return;
        lastLabelX[side] = x;
        text(xTickLabel(nm), x, xLabelY, 'middle', 12);
      });
    });
    // axis-break mark: two short slanted strokes where the scale changes
    (signed ? [-1, 1] : [1]).forEach(function (side) {
      var bx = xAt(axis.breakNm, side);
      [-2.5, 2.5].forEach(function (dx) {
        el('line', { x1: f1(bx + dx - 3), y1: py1 + 5, x2: f1(bx + dx + 3), y2: py1 - 5, stroke: fg, 'stroke-width': 2 }, gridLayer);
      });
    });
    var unitTxt = kmMode ? 'km' : 'nm';
    var ends = axisEndLabels(axisMode, heading);
    var endY = xLabelY + 20;
    if (ends) {
      var bigEnds = axisMode === 'eastwest';
      text(ends.left, px0, endY, 'start', bigEnds ? 20 : 14, 'bold');
      text(ends.right, px1, endY, 'end', bigEnds ? 20 : 14, 'bold');
    }
    text(unitTxt, signed ? cx : px1, endY - (signed ? 0 : 0), signed ? 'middle' : 'end', 12, 'bold');
    if (axisMode === 'distance') text('all directions', (px0 + px1) / 2, endY, 'middle', 12);

    // Ground strip at field elevation, with home on it
    var yGround = yOf(fieldElev);
    el('rect', { x: px0, y: f1(yGround), width: px1 - px0, height: f1(py1 - yGround), fill: gridColor }, gridLayer);
    el('line', { x1: px0, y1: f1(yGround), x2: px1, y2: f1(yGround), stroke: fg, 'stroke-width': 2 }, gridLayer);
    var homeX = xOf(0);
    var house = el('path', { d: 'M8 0L0 6V8H1V15H4V10H7V15H15V8H16V6L14 4.5V1H11V2.25L8 0ZM9 10H12V13H9V10Z',
      transform: 'translate(' + homeX.toFixed(0) + ',' + (yGround - 14).toFixed(0) + ') scale(1.4) translate(-8,-8)',
      fill: fg, stroke: darkMode ? '#000000' : '#ffffff', 'stroke-width': 1 }, gridLayer);
    house.setAttribute('data-xs-home', '1');

    // ---- formatting -------------------------------------------------------
    function formatAlt(c) {
      if (c.ground) return 'GND';
      if (unit === 'imperial') {
        if (c.ft >= 18000) return 'FL' + ('00' + Math.round(c.ft / 100)).slice(-3);
        return Math.round(c.ft) + ' ft';
      }
      return Math.round(+c.p.alt_baro) + ' m';
    }
    function formatSpeed(v) {
      return Math.round(+v) + (unit === 'imperial' ? ' kt' : ' km/h');
    }
    function altBgColor(ft) {
      if (ft < 5000) return '#444444';
      if (ft < 15000) return '#222222';
      if (ft < 30000) return '#111111';
      return '#000000';
    }
    function altPlaneColor(c) {
      if (c.ground) return '#999999';
      if (c.ft < 5000) return '#aaaaaa';
      if (c.ft < 15000) return '#cccccc';
      if (c.ft < 30000) return '#eeeeee';
      return '#ffffff';
    }

    // ---- aircraft ---------------------------------------------------------
    setupSymbols();
    var items = chosen.map(function (c) {
      var x = xOf(c.pl.along);
      var y = c.ground ? yGround - iconHalf - 2 : yOf(c.ft);
      var dim = axisMode === 'heading' && !c.emerg && Math.abs(c.pl.cross) > radiusNm / 3;   // an emergency is never dimmed
      return { c: c, x: x, y: y, dim: dim };
    });
    var placedRects = items.map(function (it) {
      return { x: it.x - iconHalf, y: it.y - iconHalf, w: iconHalf * 2, h: iconHalf * 2 };
    });
    placedRects.push({ x: homeX - 14, y: yGround - 28, w: 28, h: 28 });
    placedRects.push(labelRect);   // the provider label
    var panelRes = closestOn ? closestPanel({ container: container, planes: planes, centerLat: centerLat, centerLon: centerLon, unit: unit,
      darkMode: darkMode, labelFont: labelFont, routeHidden: routeHidden, fieldElev: fieldElev, localNow: localNow, mode: 'xs', px0: px0, py0: py0 }) : null;
    if (panelRes) placedRects.push(panelRes.rect);   // top left of the plot, kept clear of tags

    function overlaps(r) {
      var pad = 4;
      return placedRects.some(function (e) {
        return r.x < e.x + e.w + pad && r.x + r.w + pad > e.x && r.y < e.y + e.h + pad && r.y + r.h + pad > e.y;
      });
    }
    function inside(r) { return r.x >= px0 + 2 && r.y >= 2 && r.x + r.w <= px1 - 2 && r.y + r.h <= py1 - 2; }

    items.forEach(function (it) {
      var c = it.c, p = c.p;
      var s = 0;
      if (!c.ground && p.baro_rate != null) s = p.baro_rate > 500 ? 1 : (p.baro_rate < -500 ? -1 : 0);
      var rot = c.pl.dir * (90 - 20 * s);
      var g = el('g', { 'data-xs-plane': (p.flight || p.r || p.t || '?'),
        transform: 'translate(' + it.x.toFixed(0) + ',' + it.y.toFixed(0) + ')' }, planeLayer);
      if (it.dim) { g.setAttribute('opacity', '0.5'); g.setAttribute('data-xs-dim', '1'); }
      if (c.ground) g.setAttribute('data-xs-ground', '1');
      if (c.emerg) {
        el('circle', { cx: 0, cy: 0, r: iconHalf + 6, fill: 'none', stroke: fg, 'stroke-width': 3, 'stroke-dasharray': '4 3' }, g);
      }
      if (panelRes && panelRes.ref === p) {
        el('circle', { cx: 0, cy: 0, r: iconHalf + 3, fill: 'none', stroke: fg, 'stroke-width': 2, 'data-closest-marker': '1' }, g);
      }
      var inner = el('g', { transform: 'rotate(' + rot + ') scale(' + sc + ')' }, g);
      var href = '#icon-' + getIconKey(p) + '-' + instanceId;
      var ou = el('use', { width: 24, height: 24, x: -12, y: -12, fill: 'none', stroke: '#000000', 'stroke-width': 2.5 }, inner);
      ou.setAttributeNS('http://www.w3.org/1999/xlink', 'href', href);
      var use = el('use', { width: 24, height: 24, x: -12, y: -12, fill: c.emerg ? '#ffffff' : altPlaneColor(c), stroke: 'none' }, inner);
      use.setAttributeNS('http://www.w3.org/1999/xlink', 'href', href);
    });

    // ---- tags: emergencies first, the rest in drawn order ------------------
    // Tag candidates: 16 directions on four rings round the icon. Each is scored by its leader length plus how far
    // it strays from the aircraft's own height, so a tag stays near its altitude. Nothing beyond MAX_LEADER is tried.
    var RINGS = [iconHalf + 10, iconHalf + 28, iconHalf + 48, iconHalf + 70, iconHalf + 90];
    var MAX_LEADER = 100, ANGLES = 16;
    function nearestOnRect(r, x, y) {
      return { x: Math.min(Math.max(x, r.x), r.x + r.w), y: Math.min(Math.max(y, r.y), r.y + r.h) };
    }
    function candidates(it, cw, ch) {
      var out = [];
      RINGS.forEach(function (R) {
        for (var k = 0; k < ANGLES; k++) {
          var th = k * 2 * Math.PI / ANGLES, ux = Math.cos(th), uy = Math.sin(th);
          var ax = ux > 0.38 ? 1 : (ux < -0.38 ? -1 : 0), ay = uy > 0.38 ? 1 : (uy < -0.38 ? -1 : 0);
          var r = { x: it.x + ux * R - (ax < 0 ? cw : (ax === 0 ? cw / 2 : 0)),
                    y: it.y + uy * R - (ay < 0 ? ch : (ay === 0 ? ch / 2 : 0)), w: cw, h: ch };
          var np = nearestOnRect(r, it.x, it.y);
          var len = Math.hypot(np.x - it.x, np.y - it.y);
          if (len > MAX_LEADER) continue;
          var stray = Math.max(0, Math.abs(r.y + ch / 2 - it.y) - ch / 2);
          out.push({ r: r, score: len + 1.5 * stray });
        }
      });
      return out.sort(function (m, n) { return m.score - n.score; });
    }
    function leaderTo(it, r, name) {
      var np = nearestOnRect(r, it.x, it.y);
      var d = Math.hypot(np.x - it.x, np.y - it.y) || 1;
      var e = { x: it.x + (np.x - it.x) / d * iconHalf * 0.8, y: it.y + (np.y - it.y) / d * iconHalf * 0.8 };
      var ln = el('line', { x1: f1(e.x), y1: f1(e.y), x2: f1(np.x), y2: f1(np.y), stroke: lineColor,
        'stroke-width': 2.5, 'stroke-dasharray': '3 2', 'data-xs-leader': name }, leaderLayer);
      return ln;
    }
    var order = items.filter(function (i) { return i.c.emerg; }).concat(items.filter(function (i) { return !i.c.emerg; }));

    order.forEach(function (it) {
      if (it.dim) return;
      var c = it.c, p = c.p;
      var lbl = (p.flight || '').trim() || p.r || '';
      var type = (p.t || '').trim();
      var line1 = (lbl + ' ' + type).trim();
      if (axisMode === 'distance') line1 = (line1 + ' ' + compass(c.pl.bearing)).trim();
      var arrow = '';
      if (!c.ground && p.baro_rate != null && Math.abs(p.baro_rate) > 500) arrow = p.baro_rate > 0 ? ' ▲' : ' ▼';
      var line2 = formatAlt(c) + arrow + (p.gs != null ? ' ' + formatSpeed(p.gs) : '');
      var route = '';
      if (!routeHidden) route = (p.origin && p.dest) ? p.origin + ' → ' + p.dest : (p.dest ? '→ ' + p.dest : '');
      var squawkLabel = SQUAWK_LABELS[p.squawk] || '';
      if (!line1 && !squawkLabel) return;

      var card = document.createElement('div');
      card.setAttribute('data-xs-tag', (p.flight || p.r || p.t || '?'));
      card.style.cssText = 'position:absolute;left:-9999px;top:0;background:' + altBgColor(c.ft) +
        ';border:1px solid rgba(255,255,255,0.35);border-radius:5px;padding:2px 5px;font-family:' + labelFont + ';white-space:nowrap;';
      function addRow(str, weight, color) {
        var d = document.createElement('div');
        d.textContent = str;
        d.style.fontSize = '12px'; d.style.lineHeight = '14px'; d.style.color = color;
        if (weight) d.style.fontWeight = weight;
        card.appendChild(d);
      }
      if (squawkLabel) addRow(squawkLabel, 'bold', '#ffffff');
      addRow(line1, 'bold', '#ffffff');
      addRow(line2, null, '#ffffff');
      if (route) addRow(route, null, '#aaaaaa');
      cardsLayer.appendChild(card);
      var cw = card.offsetWidth, ch = card.offsetHeight;

      var cands = candidates(it, cw, ch), best = null;
      for (var i = 0; i < cands.length; i++) {
        if (inside(cands[i].r) && !overlaps(cands[i].r)) { best = cands[i].r; break; }
      }
      if (!best && c.emerg) {
        // An emergency is always tagged, even if it has to sit over something else.
        best = { x: Math.min(Math.max(it.x + RINGS[0], px0 + 2), px1 - cw - 2),
                 y: Math.min(Math.max(it.y - ch / 2, 2), py1 - ch - 2), w: cw, h: ch };
      }
      if (!best) { cardsLayer.removeChild(card); return; }
      placedRects.push(best);
      card.style.left = f1(best.x) + 'px';
      card.style.top = f1(best.y) + 'px';
      leaderTo(it, best, card.getAttribute('data-xs-tag'));
    });
  }

  // Tag sizes depend on the font, so lay out once it is loaded.
  function start() {
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(init, init); else init();
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', start);
  } else {
    start();
  }
})();
</script>{% else %}{% render "main", trmnl:trmnl, data: data, view:view %}{% endif %}
